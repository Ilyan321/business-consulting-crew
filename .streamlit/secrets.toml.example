# Example Streamlit Secrets configuration
# For Streamlit Cloud:
# 1. Go to your App Dashboard -> App Settings -> Secrets
# 2. Paste the line below with your real Groq API key:
GROQ_API_KEY = "gsk_your_actual_groq_api_key_here"

# Optional: Default model override (defaults to openai/gpt-oss-120b)
# DEFAULT_MODEL = "openai/gpt-oss-120b"
